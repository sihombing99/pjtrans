generator client {
  provider = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Car {
  id    Int     @id @default(autoincrement())
  name  String
  price String
  category String
  image String?
  year Int ?
  seats Int ?
  transmission String
  content     String @default("")
  services Service[]
}


model Service {
  id          Int    @id @default(autoincrement())
  type        String // e.g., "12 Jam + Driver"
  price       String // e.g., "Rp 2.800.000"
  description String // e.g., "Exclude BBM, Tol, Parkir"
  
  carId Int
  car   Car    @relation(fields: [carId], references: [id])
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String
}

model Slideshow {
  id        Int     @id @default(autoincrement())
  imageUrl  String
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Booking {
  id                Int      @id @default(autoincrement())
  nama              String
  whatsapp          String
  kapasitas         String
  kendaraan         String
  tanggalMulai      String
  jamJemput         String
  tanggalSelesai    String
  jamSelesai        String
  alamatJemput      String
  tujuan            String
  alamatPengantaran String
  createdAt         DateTime @default(now())
}

