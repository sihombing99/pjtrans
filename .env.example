# -----------------------------------------------------------------------------
# PJTrans Environment Variables Example
# -----------------------------------------------------------------------------
# Salin file ini menjadi .env dan isi nilai-nilainya.
# JANGAN PERNAH commit file .env yang berisi rahasia ke dalam source control!

# 1. DATABASE (Prisma / PostgreSQL)
# Gunakan format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Contoh (Lokal): postgresql://postgres:postgres@localhost:5432/pjtrans?schema=public
# Contoh (Docker): postgresql://postgres:asintel123@db:5432/pjtrans?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/database_name"

# 2. NEXTAUTH (Authentication)
# URL kanonikal aplikasi Anda. Di production, gunakan domain asli (https://example.com).
# Di lokal, biasanya http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
w
# String acak yang panjang untuk mengenkripsi session. 
# Anda bisa membuatnya dengan perintah: openssl rand -base64 32
NEXTAUTH_SECRET="your-very-secret-string-here"

# 3. ADMIN CREDENTIALS
# Kredensial statis untuk login ke dashboard /admin.
# Project ini menggunakan pengecekan langsung dari .env untuk akses admin.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="securepassword123"

# 4. NODE ENVIRONMENT (Optional)
# Biasanya diatur otomatis oleh platform deployment (Vercel, Railway, etc.)
NODE_ENV="development"
